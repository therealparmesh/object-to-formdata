{
  "name": "object-to-formdata",
  "version": "5.0.0",
  "description": "Serialize JavaScript objects into FormData.",
  "keywords": [
    "form",
    "formdata",
    "javascript",
    "object",
    "object-to-formdata",
    "submit"
  ],
  "license": "MIT",
  "author": "Parmesh Krishen",
  "repository": "github:therealparmesh/object-to-formdata",
  "files": [
    "dist/index.cjs",
    "src/index.js",
    "types.d.ts"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "src/index.js",
  "types": "types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "postpack": "rm -rf dist",
    "prepack": "bun build src/index.js --format=cjs --outfile=dist/index.cjs",
    "test": "bun test --coverage"
  },
  "packageManager": "bun@1.3.14"
}
